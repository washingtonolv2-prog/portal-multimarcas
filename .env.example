# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Dropbox (app com escopos SOMENTE LEITURA: files.metadata.read e files.content.read)
# Estas chaves ficam apenas no servidor. Nunca use o prefixo NEXT_PUBLIC_.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
# Opcional (Dropbox Business com espaço de equipe): id do namespace raiz da equipe.
# Veja o README, secao "Dropbox Business".
DROPBOX_ROOT_NAMESPACE_ID=
# Opcional (Dropbox Business): id do membro (dbmid:...) cujo acesso o app usa.
DROPBOX_SELECT_USER=
